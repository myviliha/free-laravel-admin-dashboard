APP_NAME=VuiAdmin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# The free edition renders views and nothing else, so no database is configured.
# Add one when you add data: this template does not assume a schema.

# Which means nothing may be left on the driver that assumes one. Laravel's own
# defaults for all three are `database`, so omitting these does not mean "no
# database", it means every request dies looking for one.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
